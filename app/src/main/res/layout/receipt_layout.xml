<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white">

    <LinearLayout
        android:id="@+id/layout_receipt_Content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/white">

        <!-- Logo / Tên nhà hàng -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/brand_name"
            android:textSize="22sp"
            android:fontFamily="@font/muli_black"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/slogan"
            android:textSize="12sp"
            android:fontFamily="@font/muli"
            android:textColor="@color/grey"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Đường kẻ đứt -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey"
            android:alpha="0.4" />

        <!-- Tiêu đề hóa đơn -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receipt_title"
            android:textSize="14sp"
            android:fontFamily="@font/muli_black"
            android:textColor="@color/black"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="8dp" />

        <!-- Thông tin bàn và ngày -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/txt_receipt_TableName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:fontFamily="@font/muli_black"
                android:textColor="@color/colorPrimary"
                android:text="@string/receipt_table" />

            <TextView
                android:id="@+id/txt_receipt_Date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:fontFamily="@font/muli"
                android:textColor="@color/grey" />
        </LinearLayout>

        <!-- Đường kẻ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey"
            android:alpha="0.4"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Header bảng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text="@string/dish_name_hint"
                android:textSize="11sp"
                android:fontFamily="@font/muli_black"
                android:textColor="@color/grey" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:text="@string/receipt_qty"
                android:textSize="11sp"
                android:fontFamily="@font/muli_black"
                android:textColor="@color/grey"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:text="@string/receipt_subtotal"
                android:textSize="11sp"
                android:fontFamily="@font/muli_black"
                android:textColor="@color/grey"
                android:gravity="end" />
        </LinearLayout>

        <!-- Danh sách món (dynamic) -->
        <LinearLayout
            android:id="@+id/layout_receipt_ItemList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Đường kẻ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/colorPrimary"
            android:alpha="0.5"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Tổng cộng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_total"
                android:textSize="16sp"
                android:fontFamily="@font/muli_black"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/txt_receipt_Total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:fontFamily="@font/muli_black"
                android:textColor="@color/colorPrimary" />
        </LinearLayout>

        <!-- Đường kẻ đứt dưới -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey"
            android:alpha="0.4"
            android:layout_marginBottom="12dp" />

        <!-- Lời cảm ơn -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receipt_thank_you"
            android:textSize="13sp"
            android:fontFamily="@font/muli"
            android:textColor="@color/grey"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_receipt_Share"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/receipt_share"
                android:textColor="@color/colorPrimary"
                android:fontFamily="@font/muli_black"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:backgroundTint="@color/cream"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_receipt_Close"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/receipt_close"
                android:textColor="@color/white"
                android:fontFamily="@font/muli_black"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:backgroundTint="@color/colorPrimary" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
