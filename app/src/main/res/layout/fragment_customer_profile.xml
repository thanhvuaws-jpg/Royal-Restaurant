<?xml version="1.0" encoding="utf-8"?>
<!--
    Màn hình "Lịch sử & chi tiêu".

    Bố cục cũ bọc mọi thứ trong NestedScrollView, với RecyclerView để
    `wrap_content` + `nestedScrollingEnabled="false"` — đúng lỗi đã mô tả
    ở QĐ-056: RecyclerView mất hoàn toàn khả năng tái sử dụng view và dựng
    sẵn mọi thẻ trong bộ nhớ.

    Nay chỉ còn MỘT RecyclerView chiếm trọn màn hình. Thẻ hồ sơ và ba ô
    thống kê là mục đầu tiên của chính nó, ghép vào bằng ConcatAdapter
    (xem HoSoHeaderAdapter), nên chúng vẫn cuộn theo như cũ mà không phải
    hy sinh cơ chế tái sử dụng.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_ho_so"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightwhite">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_history_bookings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp"/>

        <ProgressBar
            android:id="@+id/progress_ho_so"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
