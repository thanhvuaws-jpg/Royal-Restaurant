<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/nen_bang_duoi">

    <TextView
        android:id="@+id/item_manage_bookings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đặt lịch trước"
        android:drawablePadding="14dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textSize="16sp"
        android:textColor="@color/muc"
        android:drawableStart="@drawable/hh32_dat_lich"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/item_staff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhân viên"
        android:drawablePadding="14dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textSize="16sp"
        android:textColor="@color/muc"
        android:drawableStart="@drawable/hh32_nhan_vien"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/item_kho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kho nguyên liệu"
        android:drawablePadding="14dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textSize="16sp"
        android:textColor="@color/muc"
        android:drawableStart="@drawable/hh32_kho"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"/>

    <TextView
        android:id="@+id/item_khuon_mat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng nhập bằng khuôn mặt"
        android:drawablePadding="14dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textSize="16sp"
        android:textColor="@color/muc"
        android:drawableStart="@drawable/hh32_khuon_mat"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/vien_vang_nhat"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:id="@+id/item_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng xuất"
        android:drawablePadding="14dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:textSize="16sp"
        android:textColor="@color/son"
        android:drawableStart="@drawable/hh32_dang_xuat"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
