<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <!-- Image -->
        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/img_kiem_ke"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Ảnh nguyên liệu"
                android:src="@drawable/cafe_americano"/>
        </androidx.cardview.widget.CardView>

        <!-- Information -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_ten_nl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên nguyên liệu"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/txt_ton_so"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sổ: 0 kg"
                android:textSize="12sp"
                android:textColor="@color/grey"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Actual Count Input -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/edt_thuc_te"
                android:layout_width="90dp"
                android:layout_height="38dp"
                android:background="@drawable/round_corner_textview"
                android:backgroundTint="@color/lightwhite"
                android:hint="Không đếm"
                android:gravity="center"
                android:inputType="numberDecimal"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txt_don_vi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="kg"
                android:textSize="12sp"
                android:textColor="@color/grey"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
