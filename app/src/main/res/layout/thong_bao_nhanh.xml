<?xml version="1.0" encoding="utf-8"?>
<!-- Thông báo nhanh thay Toast mặc định (Figma .toast) — Utils/ThongBao dựng và điền. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/nen_thong_bao_nhanh"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:maxWidth="360dp"
    android:minWidth="260dp"
    android:orientation="horizontal"
    android:paddingStart="9dp"
    android:paddingTop="9dp"
    android:paddingEnd="16dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/txt_tb_dau"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:fontFamily="@font/baloo2_extrabold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:background="@drawable/dau_tb_xong"
        tools:text="✓"
        tools:textColor="#FFF3CF" />

    <TextView
        android:id="@+id/txt_tb_noi_dung"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxWidth="290dp"
        android:textColor="#FFF3D6"
        android:textSize="13.5sp"
        tools:text="Đã gọi món Phở Bò ×2" />
</LinearLayout>
