<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    tools:context=".Activities.AmountMenuActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/nga"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Custom Toolbar Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_thanh_tieu_de"
                android:elevation="4dp"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/img_amount_Back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="12dp"
                    android:src="@drawable/ic_baseline_arrow_back_24"
                    app:tint="@color/vang_sang" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="@font/baloo2_extrabold"
                    android:text="@string/enter_quantity"
                    android:textColor="@color/vang_sang"
                    android:textSize="18sp" />

            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Số lượng: bộ tăng giảm − [số] + (Figma "Nhân viên · Gọi món", .buoc).
                     Ô giữa vẫn là txtl_amount_Quantity để gõ tay và báo lỗi như cũ. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_amount_Giam"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/nen_nut_buoc"
                        android:fontFamily="@font/baloo2_extrabold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="−"
                        android:textColor="@color/son_dam"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/txtl_amount_Quantity"
                        style="@style/SonSon.ONhap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:hint="@string/enter_quantity">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_amount_Quantity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/baloo2_extrabold"
                            android:gravity="center"
                            android:inputType="number"
                            android:textColor="@color/muc"
                            android:textSize="18sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/btn_amount_Tang"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/nen_nut_buoc"
                        android:fontFamily="@font/baloo2_extrabold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="+"
                        android:textColor="@color/son_dam"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/vien_vang_nhat"
                    android:alpha="0.3" />

                <!-- Label ghi chú -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/order_note_label"
                    android:textSize="13sp"
                    android:textColor="@color/son_dam"
                    android:textStyle="bold"
                    android:fontFamily="@font/muli"
                    android:layout_marginBottom="8dp" />

                <!-- Ô nhập ghi chú -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/txtl_amount_Note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/SonSon.ONhap"
                    android:hint="@string/order_note_hint"
                    app:endIconMode="clear_text"
                    app:counterEnabled="true"
                    app:counterMaxLength="120">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_amount_Note"
                        android:maxLength="120"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muc"
                        android:fontFamily="@font/muli"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:maxLines="4"
                        android:gravity="top|start" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Ghi chú nhanh (Figma .cuon-chip): chạm để thêm vào ô ghi chú -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/nhom_ghi_chu_nhanh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    app:chipSpacingHorizontal="6dp">

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ít đường" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Không đá" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ít cay" />

                    <com.google.android.material.chip.Chip
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mang đi" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Nút xác nhận -->
                <Button
                    android:id="@+id/btn_amount_Confirm"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="@string/agree"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    tools:targetApi="lollipop" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>