<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal"
    android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thanh Toán Chuyển Khoản"
        android:fontFamily="@font/muli_black"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E0E0E0"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/img_dialogqr_QR"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:padding="8dp" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/corner_border_grey"
        android:layout_marginBottom="20dp">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TableRow android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ngân hàng: "
                    android:fontFamily="@font/muli"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/txt_dialogqr_Bank"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BIDV"
                    android:fontFamily="@font/muli_black"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </TableRow>

            <TableRow android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số tài khoản: "
                    android:fontFamily="@font/muli"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/txt_dialogqr_Account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6151099464"
                    android:fontFamily="@font/muli_black"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </TableRow>

            <TableRow android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Số tiền: "
                    android:fontFamily="@font/muli"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/txt_dialogqr_Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 VNĐ"
                    android:fontFamily="@font/muli_black"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp" />
            </TableRow>

            <TableRow>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nội dung: "
                    android:fontFamily="@font/muli"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/txt_dialogqr_Message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thanh toan"
                    android:fontFamily="@font/muli_black"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </TableRow>

        </TableLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_dialogqr_Confirm"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Tôi đã chuyển khoản thành công"
        android:textColor="@color/white"
        android:textAllCaps="false"
        android:fontFamily="@font/muli_black"
        android:background="@drawable/corner_border_primary"
        app:backgroundTint="@color/colorPrimary"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btn_dialogqr_Cancel"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Quay lại"
        android:textColor="@color/grey"
        android:textAllCaps="false"
        android:fontFamily="@font/muli"
        android:background="@android:color/transparent"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>
