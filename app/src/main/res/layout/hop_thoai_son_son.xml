<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp thoại bộ Sơn Son (Figma trang 03 .hop) — Utils/HopThoai dựng và điền.
     Huy hiệu 64dp nổi trên mép trên; tiêu đề đậm sơn son; hàng nút: viền / sơn son. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="10dp"
    android:paddingTop="4dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/khung_hop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="@drawable/nen_hop_thoai"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="42dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/txt_hop_tieu_de"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo2_extrabold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/son_dam"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Đăng xuất?" />

        <TextView
            android:id="@+id/txt_hop_noi_dung"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="#5A463A"
            android:textSize="14sp"
            tools:text="Bạn sẽ cần đăng nhập lại để tiếp tục sử dụng." />

        <FrameLayout
            android:id="@+id/khung_hop_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/cuon_hop_muc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fadeScrollbars="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ds_hop_muc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- baselineAligned=false: căn theo chân chữ thì nút viền bị kéo lên so với nút
             sơn son (chữ nút sơn son nằm cao hơn để chừa gờ 3dp) và mất viền trên. -->
        <LinearLayout
            android:id="@+id/hang_nut_hop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:gravity="center_horizontal|top"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Huy hiệu: chữ (✓ ! ✕ i) trên nền tròn, hoặc huy hiệu hình của bộ 12 menu. -->
    <TextView
        android:id="@+id/txt_huy_hieu_hop"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|center_horizontal"
        android:elevation="14dp"
        android:fontFamily="@font/baloo2_extrabold"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"
        android:textSize="30sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:background="@drawable/dau_hop_tin"
        tools:text="i"
        tools:textColor="#FFE3A0" />

    <ImageView
        android:id="@+id/img_huy_hieu_hop"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-2dp"
        android:elevation="14dp"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</FrameLayout>
