<?xml version="1.0" encoding="utf-8"?>
<!-- Cài đặt đăng nhập bằng khuôn mặt cho tài khoản đang đăng nhập (QĐ-103) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightwhite"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/img_cdkm_quay_lai"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Đăng nhập bằng khuôn mặt"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/img_cdkm_bieu_tuong"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Khuôn mặt"
                android:src="@drawable/ic_khuon_mat_24"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/txt_cdkm_trang_thai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Chưa bật trên máy này"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_cdkm_chi_tiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="Bật để lần sau đăng nhập bằng cách nhìn vào camera và chớp mắt, không cần gõ mật khẩu."
                android:textColor="@color/grey"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cdkm_bat"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Bật đăng nhập bằng khuôn mặt"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:backgroundTint="@color/colorPrimary"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cdkm_tat"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="Tắt trên máy này"
                android:textAllCaps="false"
                android:textColor="#D32F2F"
                android:textSize="16sp"
                android:visibility="gone"
                app:cornerRadius="12dp"
                app:strokeColor="#D32F2F" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:lineSpacingExtra="3dp"
        android:text="• Ảnh khuôn mặt chỉ được xử lý trên máy này; máy chủ không nhận ảnh hay dữ liệu khuôn mặt.\n• Phải chớp mắt khi quét — giơ ảnh chụp không đăng nhập được.\n• Khi quản lý đặt lại mật khẩu hoặc đổi quyền tài khoản, đăng nhập bằng khuôn mặt tự tắt."
        android:textColor="@color/grey"
        android:textSize="13sp" />
</LinearLayout>
