<?xml version="1.0" encoding="utf-8"?>
<!--
    Một mã giảm giá của khách.

    Mã in to, giãn chữ và dùng phông monospace vì khách sẽ ĐỌC nó cho nhân
    viên nghe. Chữ càng rõ ràng thì càng ít phải đọc lại.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/dai_mau_ma"
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/gold_400"/>

        <!-- Vé ưu đãi: ảnh nền 1200×420 (tỉ lệ ~2,86) KÈM mức giảm in đè.
             Trước đây ảnh bị ép vào ô 64×40dp không chữ nên chỉ còn một
             thanh màu tối, không ai hiểu là gì (H31). -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp">

            <ImageView
                android:id="@+id/img_ve_voucher"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ve_vang"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/txt_nhan_ve"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/gold_300"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="14dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/txt_ten_ma"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"/>

                <TextView
                    android:id="@+id/txt_trang_thai_ma"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txt_macode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="19sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:textColor="@color/colorPrimary"
                android:background="#FFF6DC"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>

            <TextView
                android:id="@+id/txt_han_ma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="11sp"
                android:textColor="#8D6E63"/>

            <TextView
                android:id="@+id/txt_dk_ma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="10sp"
                android:textColor="#A99C8F"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
