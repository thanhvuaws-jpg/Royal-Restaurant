<?xml version="1.0" encoding="utf-8"?>
<!--
    Màn hình "Điểm danh & Quà tặng".

    Dựng theo bản thiết kế người dùng gửi:
      - Bảng 7 ô điểm danh (3 cột + ô mốc ngày 7 trải rộng)
      - Bảng số điểm tích lũy + thanh tiến trình 7 ngày
      - Hai nút: ĐIỂM DANH NGAY / ĐỔI PHIẾU GIẢM GIÁ
      - Danh sách voucher đổi được và mã đang có

    Một khác biệt có chủ đích so với bản mẫu: nút "Điểm danh ngay" dùng
    NÂU của ứng dụng thay vì xanh dương. Toàn bộ app đang là nâu-vàng, một
    nút xanh sẽ là màu duy nhất không thuộc bảng màu nào.

    Dùng RecyclerView cho danh sách phía dưới; phần trên cố định vì nó
    ngắn và là thứ người dùng vào đây để bấm.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightwhite">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <!-- ══════════ BẢNG ĐIỂM DANH 7 NGÀY ══════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#F5EDE6">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dd_tieu_de"
                        android:gravity="center"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.03"
                        android:textColor="@color/colorPrimaryDark"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/dd_phu_de"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#8D6E63"/>

                    <!-- 6 ô đầu, 3 cột -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_o_ngay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:nestedScrollingEnabled="false"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ══════════ ĐIỂM TÍCH LŨY + TIẾN TRÌNH ══════════ -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false">

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/colorPrimary">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dd_so_diem_cua_ban"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:textColor="#E8DAD3"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_xu"
                                android:contentDescription="@string/dd_diem"/>

                            <TextView
                                android:id="@+id/txt_so_diem"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="0"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/white"/>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/txt_goi_y_doi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:textSize="10sp"
                            android:textColor="#E8DAD3"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dd_tien_trinh"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorPrimaryDark"/>

                        <ProgressBar
                            android:id="@+id/progress_chuoi"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="12dp"
                            android:max="7"
                            android:progressTint="@color/gold_400"
                            android:progressBackgroundTint="#E9E4E1"/>

                        <TextView
                            android:id="@+id/txt_chuoi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textSize="11sp"
                            android:textColor="#8D6E63"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:layout_marginTop="6dp">

                            <ImageView
                                android:id="@+id/img_hang_badge"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/rank_dong"
                                android:scaleType="fitCenter"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="Rank badge" />

                            <TextView
                                android:id="@+id/txt_hang"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/colorPrimary"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- ══════════ HAI NÚT ══════════
                 baselineAligned=false: một nút chữ 2 dòng, một nút 1 dòng thì
                 LinearLayout căn theo đường chân chữ và đẩy lệch hai nút (H31). -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_marginTop="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_diem_danh"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/dd_nut_diem_danh"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:letterSpacing="0"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="14dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_doi_phieu"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/dd_nut_doi_phieu"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:letterSpacing="0"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:backgroundTint="@color/gold_400"
                    app:cornerRadius="14dp"/>

            </LinearLayout>

            <!-- ══════════ DANH SÁCH ══════════ -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/txt_tieu_de_ds"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dd_ma_cua_toi"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:id="@+id/txt_dem_ds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#8D6E63"/>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_danh_sach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/txt_rong_ds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="28dp"
                android:textSize="13sp"
                android:textColor="#9E9E9E"
                android:visibility="gone"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
