<?xml version="1.0" encoding="utf-8"?>
<!-- Trang chủ nhân viên / quản lý — bộ Sơn Son (Figma trang 02 "Trang chủ nhân viên, quản lý"):
     tấm hoành mang lời chào, lưới 3 cột huy hiệu, mục có dấu thoi vàng. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sv_display_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kem"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!-- Tấm hoành lời chào (.chao) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="128dp"
            app:cardBackgroundColor="#140B08"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#99D9A441"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_hoanh_son_mai" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/phu_banner_trai" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="120dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:id="@+id/txt_welcome_Greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_user"
                        android:textColor="#EAD9B8"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/txt_welcome_UserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/baloo2_extrabold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="Royal Restaurant"
                        android:textColor="@color/vang_sang"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Hãy phục vụ khách hàng tốt nhất nhé!"
                        android:textColor="#F0DFBF"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Lưới huy hiệu 3 cột (.luoi / .o-menu). Ô nào không đúng quyền thì mã ẩn đi. -->
        <GridLayout
            android:id="@+id/grid_display_HomeActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:columnCount="3"
            android:useDefaultMargins="false">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_display_HomeStatistic"
                style="@style/OTrangChu">
                <LinearLayout style="@style/OTrangChuThan">
                    <ImageView style="@style/OTrangChuHuyHieu" android:src="@drawable/ic_hh_thong_ke" />
                    <TextView style="@style/OTrangChuChu" android:text="@string/nav_statistic" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_display_HomeViewTable"
                style="@style/OTrangChu">
                <LinearLayout style="@style/OTrangChuThan">
                    <ImageView style="@style/OTrangChuHuyHieu" android:src="@drawable/ic_hh_ban_an" />
                    <TextView style="@style/OTrangChuChu" android:text="Bàn ăn" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_display_HomeViewMenu"
                style="@style/OTrangChu">
                <LinearLayout style="@style/OTrangChuThan">
                    <ImageView style="@style/OTrangChuHuyHieu" android:src="@drawable/ic_hh_thuc_don" />
                    <TextView style="@style/OTrangChuChu" android:text="@string/nav_menu" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_display_HomeViewStaff"
                style="@style/OTrangChu">
                <LinearLayout style="@style/OTrangChuThan">
                    <ImageView style="@style/OTrangChuHuyHieu" android:src="@drawable/ic_hh_nhan_vien" />
                    <TextView style="@style/OTrangChuChu" android:text="@string/nav_staff" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_display_HomeKho"
                style="@style/OTrangChu">
                <LinearLayout style="@style/OTrangChuThan">
                    <ImageView style="@style/OTrangChuHuyHieu" android:src="@drawable/ic_hh_kho" />
                    <TextView style="@style/OTrangChuChu" android:text="Kho" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layout_display_HomeDatLich"
                style="@style/OTrangChu">
                <LinearLayout style="@style/OTrangChuThan">
                    <ImageView style="@style/OTrangChuHuyHieu" android:src="@drawable/ic_hh_dat_lich" />
                    <TextView style="@style/OTrangChuChu" android:text="Đặt lịch" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- Menu nổi bật -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_display_HomeCategoryHeader"
                style="@style/SonSon.TieuDeMuc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/featured_menu" />

            <TextView
                android:id="@+id/txt_display_HomeViewAllCategory"
                style="@style/LienKetMuc"
                android:text="Xem tất cả ›" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_display_HomeCategoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-6dp"
            android:clipToPadding="false" />

        <!-- Thanh toán hôm nay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_display_HomeStatisticHeader"
                style="@style/SonSon.TieuDeMuc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/today_payment" />

            <TextView
                android:id="@+id/txt_display_HomeViewAllStatistic"
                style="@style/LienKetMuc"
                android:text="@string/view_report" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcv_display_HomeOrderToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="-6dp"
            android:clipToPadding="false"
            tools:listitem="@layout/custom_layout_displaystatistic" />
    </LinearLayout>
</ScrollView>
