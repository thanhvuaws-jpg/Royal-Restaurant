<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activities.PaymentActivity"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Custom Toolbar Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        android:padding="8dp">

        <ImageView
            android:id="@+id/img_payment_BackBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_baseline_arrow_back_24"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/txt_payment_ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:fontFamily="@font/muli_black"
            android:text="@string/payment_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textAllCaps="true" />

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_payment_TableName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Bàn 01"
            android:textSize="18sp"
            android:fontFamily="@font/muli_black"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/txt_payment_OrderDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="20/12/2026"
            android:textSize="16sp"
            android:fontFamily="@font/muli"
            android:textColor="@color/grey" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_payment_DishList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        tools:targetApi="lollipop">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ═══════════ MÃ GIẢM GIÁ ═══════════
                 Đặt NGAY TRÊN nút thanh toán, không nhét vào màn hình khác:
                 khách đọc mã lúc nhân viên chuẩn bị bấm thanh toán, nên ô
                 nhập phải nằm trong tầm mắt ở đúng thời điểm đó. -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp">

                <EditText
                    android:id="@+id/edt_ma_giam_gia"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_o_tim_kiem"
                    android:hint="@string/tt_nhap_ma"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:maxLength="20"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:textColor="@color/black"
                    android:textColorHint="#9E9E9E"
                    android:imeOptions="actionDone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ap_ma"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/tt_ap_ma"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimaryDark"
                    android:backgroundTint="@color/gold_400"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Kết quả tra mã: xanh khi hợp lệ, đỏ khi bị từ chối.
                 Ẩn hẳn khi chưa nhập gì để thẻ không chừa khoảng trống. -->
            <TextView
                android:id="@+id/txt_ket_qua_ma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#EEEAE8" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/layout_payment_TotalContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/btn_payment_Pay"
                android:layout_toLeftOf="@+id/btn_payment_Pay"
                android:layout_alignParentStart="true"
                android:layout_alignParentLeft="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_label"
                    android:textColor="@color/grey"
                    android:fontFamily="@font/muli"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txt_payment_TotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="780,000 VNĐ"
                    android:paddingTop="4dp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/muli_black"
                    android:textSize="22sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

            </LinearLayout>

            <Button
                android:id="@+id/btn_payment_Pay"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="@drawable/corner_border_primary"
                app:backgroundTint="@color/colorPrimary"
                android:text="@string/pay_btn"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="@font/muli_black"
                android:paddingLeft="24dp"
                android:paddingRight="24dp" />

        </RelativeLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>