<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ đơn (Figma .the-don): "Mã đơn · ngày" chữ mờ + nhãn trạng thái; nhân viên, bàn;
     số tiền chữ Baloo sơn son. Dùng ở trang chủ (trượt ngang) và màn thống kê. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_customstatistic_OrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/chu_mo"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="Mã đơn: #17977" />

            <TextView
                android:id="@+id/txt_customstatistic_Status"
                style="@style/SonSon.HuyHieu.Xong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="Đã thanh toán" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_customstatistic_StaffName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/muc"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Nhân viên sân thử" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_customstatistic_TableName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/chu_mo"
                android:textSize="13sp"
                tools:text="Bàn 1" />

            <TextView
                android:id="@+id/txt_customstatistic_OrderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/chu_mo"
                android:textSize="12sp"
                tools:text="16/10/2026" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@color/vien_vang_nhat" />

        <TextView
            android:id="@+id/txt_customstatistic_TotalAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:ellipsize="end"
            android:fontFamily="@font/baloo2_extrabold"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/son"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="85.000 đ" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
