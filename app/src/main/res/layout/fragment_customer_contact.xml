<?xml version="1.0" encoding="utf-8"?>
<!--
    Màn hình Liên hệ / Hỗ trợ.

    BA THAY ĐỔI SO VỚI BẢN CŨ, VÀ LÝ DO
    ====================================
    1. BỌC TRONG ScrollView. Bản cũ là LinearLayout trần với logo 120dp và ba
       thẻ; thêm thẻ thứ tư là tràn đáy trên máy màn hình nhỏ — mà phần bị cắt
       lại nằm dưới cùng, nơi không ai biết là có.

    2. THẺ CHAT LÊN ĐẦU. Nó là cách liên hệ duy nhất được ghi lại thành hồ sơ,
       trả lời được ngoài giờ, và không bắt khách rời khỏi ứng dụng. Hotline
       và email vẫn còn nguyên nhưng lùi xuống dưới.

    3. LOGO NHỎ LẠI (120dp -> 84dp). Chỗ đó phải dành cho việc khách tới đây
       để làm, không phải cho thương hiệu.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kem"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp"
        android:gravity="center_horizontal">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/logo_royal_trong"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HỖ TRỢ KHÁCH HÀNG"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/son_dam"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn cách liên hệ thuận tiện nhất với bạn."
            android:textSize="15sp"
            android:textColor="@color/chu_mo"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp" />

        <!-- ═══════════ Chat với nhân viên — lối chính ═══════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_chat_ho_tro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical"
                android:background="@drawable/nen_the_son">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_hh_chat"
                    android:contentDescription="Trò chuyện" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NHẮN TIN NGAY"
                        android:textColor="#D8C6A6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chat với nhân viên"
                        android:textColor="@color/vang_sang"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trợ lý trả lời ngay, nhân viên phản hồi sau"
                        android:textColor="#D8C6A6"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!--
                    Huy hiệu đếm tin chưa đọc. Ẩn khi bằng 0 — một vòng tròn
                    ghi "0" vẫn kéo mắt người dùng về phía nó y như khi có
                    tin thật.
                -->
                <TextView
                    android:id="@+id/huy_hieu_chat"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_huy_hieu_do"
                    android:gravity="center"
                    android:textColor="@color/vang_sang"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════ Hotline & Zalo ═══════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_contact_hotline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:background="@drawable/nen_the_then">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_baseline_local_phone_24"
                    app:tint="@color/vang_sang"
                    android:contentDescription="Điện thoại" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOTLINE &amp; ZALO"
                        android:textColor="#D8C6A6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0856 761 038"
                        android:textColor="@color/vang_sang"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════ Chỉ đường ═══════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_contact_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:background="@drawable/nen_the_then">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_baseline_location_on_24"
                    app:tint="@color/vang_sang"
                    android:contentDescription="Bản đồ" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TÌM ĐƯỜNG ĐI"
                        android:textColor="#D8C6A6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cơ sở TP.Hồ Chí Minh"
                        android:textColor="@color/vang_sang"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ═══════════ Email ═══════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_contact_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:background="@drawable/nen_the_then">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_baseline_email_24"
                    app:tint="@color/vang_sang"
                    android:contentDescription="Email" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GÓP Ý &amp; PHẢN HỒI"
                        android:textColor="#D8C6A6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gửi Email kèm ảnh cho quản lý"
                        android:textColor="@color/vang_sang"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Đăng nhập bằng khuôn mặt (QĐ-103): thanh dưới của khách đã đủ 5 mục nên
             lối vào cài đặt đặt ở đây (menu bên cũng có). -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_khuon_mat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:foreground="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:background="@drawable/nen_the_then">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_hh_khuon_mat"
                    android:contentDescription="Khuôn mặt" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BẢO MẬT"
                        android:textColor="#D8C6A6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đăng nhập bằng khuôn mặt"
                        android:textColor="@color/vang_sang"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
