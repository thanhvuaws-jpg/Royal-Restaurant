<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/kem">

    <!-- === CHIP FILTER === -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup_statistic_Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_Today"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_today"
                android:fontFamily="@font/muli"
                style="@style/SonSon.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_7Days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_7days"
                android:fontFamily="@font/muli"
                android:checked="true"
                style="@style/SonSon.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_30Days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_30days"
                android:fontFamily="@font/muli"
                style="@style/SonSon.Chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_filter_All"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_all"
                android:fontFamily="@font/muli"
                style="@style/SonSon.Chip" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- === 3 SUMMARY CARDS === -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <!-- Tổng doanh thu -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            tools:targetApi="lollipop">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/nen_the_son">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_revenue_label"
                    android:textColor="#F0D9B0"
                    android:textSize="11sp"
                    android:fontFamily="@font/muli" />

                <TextView
                    android:id="@+id/txt_statistic_TotalRevenue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zero_vnd"
                    android:textColor="@color/vang_sang"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeMaxTextSize="16sp"
                    android:textSize="16sp"
                    android:fontFamily="@font/baloo2_extrabold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Số đơn -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.7"
            android:layout_margin="4dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            tools:targetApi="lollipop">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_order_count"
                    android:textColor="@color/chu_mo"
                    android:textSize="11sp"
                    android:fontFamily="@font/muli" />

                <TextView
                    android:id="@+id/txt_statistic_OrderCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="@color/muc"
                    android:textSize="20sp"
                    android:fontFamily="@font/baloo2_extrabold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Trung bình/đơn -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            tools:targetApi="lollipop">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stat_avg_order"
                    android:textColor="@color/chu_mo"
                    android:textSize="11sp"
                    android:fontFamily="@font/muli" />

                <TextView
                    android:id="@+id/txt_statistic_AvgOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/zero_vnd"
                    android:textColor="@color/son"
                    android:textSize="13sp"
                    android:fontFamily="@font/baloo2_extrabold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- === BIỂU ĐỒ === -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        tools:targetApi="lollipop">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stat_chart_title"
                style="@style/SonSon.TieuDeMuc"
                android:textSize="15sp"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/chart_statistic_Revenue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- === DANH SÁCH ĐƠN === -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/order_detail_label"
        style="@style/SonSon.TieuDeMuc"
        android:layout_marginStart="20dp"
        android:layout_marginLeft="20dp"
        android:layout_marginBottom="6dp"
        android:textColor="@color/son_dam" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_statistic_OrderList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>