<?xml version="1.0" encoding="utf-8"?>
<!-- Màn chào — bộ Sơn Son (Figma trang 02 "Màn chào"): nền sơn then, tấm hoành trên đầu,
     logo vàng, nút thếp vàng "Đăng nhập" và nút viền vàng "Đăng ký". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_ben"
    android:orientation="vertical"
    tools:context=".Activities.WelcomeActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_hoanh_son_mai" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_gravity="bottom"
            android:background="@color/vang" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/sang_giua_man_chao"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/img_welcome_Logo"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_royal_trong" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/baloo2_extrabold"
            android:gravity="center"
            android:text="@string/app_name"
            android:textColor="@color/vang_sang"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/slogan"
            android:textColor="@color/chu_phu_menu_ben"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_welcome_Login"
            style="@style/SonSon.Button.Vang"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/login"
            android:textSize="17sp"
            android:transitionName="transition_login" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_welcome_SignUp"
            style="@style/SonSon.Button.VienToi"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:text="@string/register"
            android:textSize="17sp"
            android:transitionName="transition_signup" />
    </LinearLayout>
</LinearLayout>
