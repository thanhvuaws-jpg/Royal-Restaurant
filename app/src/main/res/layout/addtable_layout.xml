<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical"
    android:fillViewport="true"
    android:background="@android:color/transparent">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/white"
        app:cardPreventCornerOverlap="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:context=".Activities.AddTableActivity"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:id="@+id/img_addtable_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_baseline_arrow_back_24"
                android:padding="8dp"
                android:contentDescription="@string/back"
                app:tint="@color/black"
                android:layout_marginBottom="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_table_title"
                android:textSize="32sp"
                android:fontFamily="@font/muli_black"
                android:textColor="@color/black"
                android:textAllCaps="true"
                android:layout_marginBottom="32dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/txtl_addtable_TableName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:hint="@string/table_name_hint"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_addtable_TableName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_addtable_CreateTable"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="@string/create_table_btn"
                android:textColor="@color/white"
                android:background="@drawable/corner_border_primary"
                app:backgroundTint="@color/colorPrimary"
                android:elevation="4dp"
                android:textAllCaps="false"
                android:textSize="18sp"
                tools:targetApi="lollipop" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>