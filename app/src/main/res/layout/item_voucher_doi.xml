<?xml version="1.0" encoding="utf-8"?>
<!-- Một phiếu có thể đổi bằng điểm -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Vé ưu đãi: ảnh nền 1200×420 (tỉ lệ ~2,86) KÈM mức giảm in đè.
             Trước đây ảnh bị ép vào ô 56×36dp không chữ nên chỉ còn một
             thanh màu tối, không ai hiểu là gì (H31). -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/img_ve_voucher"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/ve_vang"
                android:importantForAccessibility="no" />

            <!-- Mức giảm in trên cuống trái của vé (~34% bề ngang), như Figma .ve-hinh b. -->
            <TextView
                android:id="@+id/txt_nhan_ve"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/baloo2_extrabold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="#FFF3CF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txt_ten_voucher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryDark"/>

            <TextView
                android:id="@+id/txt_mota_voucher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="11sp"
                android:textColor="#7A6553"/>

            <TextView
                android:id="@+id/txt_dieu_kien"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#B3261F"
                android:visibility="gone"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_doi"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:cornerRadius="11dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
