<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:background="@color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_booking_table"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/table_list_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"/>

            <TextView
                android:id="@+id/txt_booking_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="@string/customer_btn_new_booking"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"
                android:padding="6dp"
                android:background="@drawable/border_status_pending"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/txt_booking_customer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/customer_default_name"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txt_booking_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/booking_no_datetime"
            android:textSize="15sp"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/txt_booking_dishes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/booking_total_default"
            android:textSize="15sp"
            android:textColor="@color/grey"/>

        <LinearLayout
            android:id="@+id/layout_booking_actions"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_booking"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_booking_btn_cancel"
                android:textColor="@color/grey"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_checkin_booking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_booking_btn_confirm"
                android:textColor="@color/white"
                android:backgroundTint="@color/status_occupied"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_customer_arrived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khách đã đến"
                android:textColor="@color/white"
                android:backgroundTint="@color/status_occupied"
                android:layout_marginStart="8dp"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
