<?xml version="1.0" encoding="utf-8"?>
<!-- Tấm chọn tài khoản hiện từ dưới lên khi một khuôn mặt khớp nhiều tài khoản trên máy (QĐ-103) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tam_chon_tk_km"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chip_quyen_km"
        android:backgroundTint="#6D5A50" />

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_chip_quyen_km"
        android:backgroundTint="#33D4AF37">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_khuon_mat_24"
            app:tint="@color/gold_400" />
    </FrameLayout>

    <TextView
        android:id="@+id/txt_ctk_tieu_de"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Chọn tài khoản để vào"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_ctk_phu_de"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#BCAAA4"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fadeScrollbars="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/ds_ctk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ctk_mat_khau"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="Dùng mật khẩu"
            android:textAllCaps="false"
            android:textColor="#BCAAA4"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ctk_quet_lai"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Quét lại"
            android:textAllCaps="false"
            android:textColor="@color/gold_400"
            android:textSize="15sp"
            app:cornerRadius="26dp"
            app:strokeColor="@color/gold_400" />
    </LinearLayout>

</LinearLayout>
