<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:padding="8dp"
        android:gravity="center_vertical">

        <!-- Image -->
        <ImageView
            android:id="@+id/img_preorder_dish"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cafe_americano"/>

        <!-- Details -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/txt_preorder_dish_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dish_name_placeholder"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/txt_preorder_dish_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dish_price_placeholder"
                android:textSize="14sp"
                android:textColor="@color/colorPrimary"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Count controls -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <ImageView
                android:id="@+id/img_preorder_minus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_baseline_remove_circle_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/grey"/>

            <TextView
                android:id="@+id/txt_preorder_qty"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:text="@string/qty_zero"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"/>

            <ImageView
                android:id="@+id/img_preorder_plus"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_baseline_add_circle_24"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/colorPrimary"/>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
