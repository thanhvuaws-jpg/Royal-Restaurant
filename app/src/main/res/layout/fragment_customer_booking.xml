<?xml version="1.0" encoding="utf-8"?>
<!--
    Màn hình "Lịch hẹn đặt bàn của bạn".

    VÌ SAO BỎ NestedScrollView
    ==========================
    Bố cục cũ là:

        NestedScrollView
          └ LinearLayout
              └ RecyclerView  height="wrap_content"
                              nestedScrollingEnabled="false"

    Hai thuộc tính đó cộng lại làm RecyclerView **mất hoàn toàn khả năng
    tái sử dụng view**: nó buộc phải cao bằng tổng chiều cao mọi mục, nên
    dựng sẵn TẤT CẢ thẻ ngay từ đầu và giữ chúng trong bộ nhớ. Với 50
    phiếu là 50 CardView cùng tồn tại — đúng nguyên nhân gây nặng máy,
    chứ không phải kích thước dữ liệu tải về.

    Nay RecyclerView tự cuộn, chỉ dựng đủ số thẻ vừa màn hình (khoảng 4-5)
    và tái dùng chúng khi cuộn. Số phiếu có tăng lên bao nhiêu thì số view
    trong bộ nhớ vẫn không đổi.

    Phần đầu (nút đặt bàn + dãy lọc) tách ra ngoài, đứng yên khi cuộn —
    tiện hơn cho người dùng so với việc phải cuộn ngược lên mới đổi được
    bộ lọc.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kem">

    <!-- ══════════════ Phần đầu cố định ══════════════ -->
    <!-- Bộ Sơn Son (Figma "Khách · Đặt bàn & món"): thẻ banner tấm hoành kêu gọi đặt bàn
         + nút thếp vàng; tiêu đề mục dấu thoi vàng; chip lọc viền vàng. -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#140B08"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#99D9A441"
            app:strokeWidth="1dp">

            <!-- Cao theo khối chữ, tối thiểu 156dp: cố định 156dp thì máy để cỡ chữ lớn
                 (tiêu đề xuống 2 dòng) bị cắt mất nửa dưới nút "Đặt bàn & món".
                 Ảnh nền và lớp phủ BÁM mép trên/dưới của khối chữ (RelativeLayout). Dùng
                 FrameLayout wrap_content thì ảnh match_parent bị đo theo cỡ gốc của tấm
                 ảnh dọc và banner phình kín màn hình (đã thử 25/10/2026). -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/khoi_chu_banner"
                    android:layout_alignBottom="@+id/khoi_chu_banner"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_hoanh_son_mai" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/khoi_chu_banner"
                    android:layout_alignBottom="@+id/khoi_chu_banner"
                    android:background="@drawable/phu_banner_trai" />

                <LinearLayout
                    android:id="@+id/khoi_chu_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="156dp"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="110dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/baloo2_extrabold"
                        android:includeFontPadding="false"
                        android:text="Giữ bàn trước, món lên ngay khi tới"
                        android:textColor="@color/vang_sang"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Chọn giờ, chọn bàn còn trống, đặt món trước"
                        android:textColor="#F0DFBF"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_new_booking"
                        style="@style/SonSon.Button.Vang"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:minWidth="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Đặt bàn &amp; món"
                        android:textSize="15sp" />
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/SonSon.TieuDeMuc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/customer_active_bookings_title" />

            <!-- Số phiếu khớp bộ lọc hiện tại. Cho người dùng biết danh
                 sách còn dài bao nhiêu mà không phải cuộn tới cuối. -->
            <TextView
                android:id="@+id/txt_tong_so_phieu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/son"/>

        </LinearLayout>

        <!-- Dãy lọc theo trạng thái, cuộn ngang. Sinh động trong Fragment. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/layout_chip_loc"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- ══════════════ Danh sách ══════════════ -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_lich_hen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_active_bookings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"/>

            <!-- Trạng thái rỗng. Nội dung đổi theo bộ lọc đang chọn nên
                 chữ được đặt trong Fragment, không ghi cứng ở đây. -->
            <LinearLayout
                android:id="@+id/layout_rong"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_hh_dat_lich"
                    android:alpha="0.92"
                    android:contentDescription="@string/customer_empty_bookings"/>

                <TextView
                    android:id="@+id/txt_rong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/customer_empty_bookings"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/son_dam"/>

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_lich_hen"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:visibility="gone"/>

        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
