<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.OrderDrinkApp" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">

        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color.
             Trước đây là teal_200 (xanh ngọc mặc định của mẫu dự án Android):
             nút trong MỌI hộp thoại, ô đánh dấu, nút chọn đều ra xanh ngọc,
             lệch hẳn tông nâu–vàng của app (lỗi H32). -->
        <item name="colorSecondary">@color/colorPrimary</item>
        <item name="colorSecondaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="21">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>


    <!-- Menu style -->
    <style name="navigationTheme">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorControlHighlight">@color/colorAccent</item>
    </style>

    <!-- Popup style -->
    <style name="PopUpActivity" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Theme AppCompat/Material đọc thuộc tính KHÔNG có tiền tố android:.
             Thiếu dòng này thì cửa sổ vẫn vẽ thanh tiêu đề (label của Activity)
             đè lên màn phía sau. -->
        <item name="windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <!-- Màu thương hiệu như phần còn lại của app. Không khai báo thì theme
             Dialog dùng tím mặc định của Material cho ô nhập và nút viền. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorSecondary">@color/colorAccent</item>
    </style>

    <!-- Chữ tab màn Đặt lịch: một cỡ cho mọi tab (H23). -->
    <style name="ChuTabDatLich" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>