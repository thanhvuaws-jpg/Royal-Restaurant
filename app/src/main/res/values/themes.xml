<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme toàn app theo bộ giao diện Sơn Son (QĐ-112, Figma trang 03 "Thành phần").
         Màu gốc (colorPrimary, black, grey, lightwhite…) đã đổi giá trị trong colors.xml;
         ở đây gắn kiểu riêng cho từng loại thành phần để mọi màn của cả 4 vai đổi một lượt. -->
    <style name="Theme.OrderDrinkApp" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">

        <!-- Sơn son là màu chính, chữ trên nền sơn son là vàng nhạt. -->
        <item name="colorPrimary">@color/son</item>
        <item name="colorPrimaryVariant">@color/son_dam</item>
        <item name="colorOnPrimary">@color/vang_sang</item>
        <!-- Secondary cũng là sơn son: ô đánh dấu, công tắc, nút nổi, con trỏ ô nhập.
             (Trước đây là teal_200 mặc định, lỗi H32.) -->
        <item name="colorSecondary">@color/son</item>
        <item name="colorSecondaryVariant">@color/son_dam</item>
        <item name="colorOnSecondary">@color/vang_sang</item>
        <item name="colorSurface">@color/nga</item>
        <item name="colorOnSurface">@color/muc</item>
        <item name="android:colorBackground">@color/kem</item>
        <item name="colorOnBackground">@color/muc</item>
        <!-- Nền trang: kem giấy dó. -->
        <item name="android:windowBackground">@color/kem</item>
        <item name="android:textColorPrimary">@color/muc</item>
        <item name="android:textColorSecondary">@color/chu_mo</item>
        <item name="colorControlNormal">@color/chu_mo</item>
        <item name="colorControlActivated">@color/son</item>
        <item name="colorControlHighlight">#29D9A441</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/son_dam</item>

        <!-- Theme "Bridge" mặc định dựng <Button> thành nút AppCompat xám: bật bộ dựng của
             Material để mọi <Button>, CheckBox, RadioButton nhận kiểu Sơn Son bên dưới. -->
        <item name="viewInflaterClass">com.google.android.material.theme.MaterialComponentsViewInflater</item>
        <!-- Thành phần -->
        <item name="materialButtonStyle">@style/SonSon.Button</item>
        <item name="materialButtonOutlinedStyle">@style/SonSon.Button.Vien</item>
        <item name="chipStyle">@style/SonSon.Chip.HanhDong</item>
        <item name="textInputStyle">@style/SonSon.ONhap</item>
        <item name="tabStyle">@style/SonSon.Tab</item>
        <item name="bottomNavigationStyle">@style/SonSon.ThanhDuoi</item>
        <item name="materialCardViewStyle">@style/SonSon.The</item>
        <item name="toolbarStyle">@style/SonSon.ThanhTieuDe</item>
        <item name="floatingActionButtonStyle">@style/SonSon.Fab</item>
        <item name="drawerArrowStyle">@style/SonSon.MuiTenMenu</item>
        <!-- Hộp thoại hệ thống còn sót (chọn ngày giờ, bảng chọn dưới): cùng màu.
             Hộp thoại của app đi qua Utils/HopThoai (vẽ theo mẫu Figma). -->
        <item name="alertDialogTheme">@style/SonSon.HopThoaiHeThong</item>
        <item name="materialAlertDialogTheme">@style/SonSon.HopThoaiHeThong</item>
        <item name="android:datePickerDialogTheme">@style/SonSon.LichChon</item>
        <item name="android:timePickerDialogTheme">@style/SonSon.LichChon</item>
        <item name="bottomSheetDialogTheme">@style/SonSon.BangDuoi</item>
    </style>


    <!-- Menu style -->
    <!-- Menu bên sơn then (QĐ-112): tiêu đề nhóm ("Quản lý") màu chữ phụ, gợn bấm vàng nhạt. -->
    <style name="navigationTheme">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorControlHighlight">#33D9A441</item>
        <item name="android:textColorSecondary">@color/chu_phu_menu_ben</item>
        <item name="android:listDivider">@drawable/vach_menu_ben</item>
    </style>

    <!-- Popup style -->
    <style name="PopUpActivity" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <!-- Theme AppCompat/Material đọc thuộc tính KHÔNG có tiền tố android:.
             Thiếu dòng này thì cửa sổ vẫn vẽ thanh tiêu đề (label của Activity)
             đè lên màn phía sau. -->
        <item name="windowNoTitle">true</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <!-- Màu thương hiệu như phần còn lại của app. Không khai báo thì theme
             Dialog dùng tím mặc định của Material cho ô nhập và nút viền. -->
        <item name="colorPrimary">@color/son</item>
        <item name="colorPrimaryVariant">@color/son_dam</item>
        <item name="colorSecondary">@color/son</item>
        <item name="materialButtonStyle">@style/SonSon.Button</item>
        <item name="materialButtonOutlinedStyle">@style/SonSon.Button.Vien</item>
    </style>

    <!-- Chữ tab màn Đặt lịch: một cỡ cho mọi tab (H23). -->
    <style name="ChuTabDatLich" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">13sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <!-- ═══════════════════ Bộ thành phần Sơn Son (Figma trang 03) ═══════════════════ -->

    <!-- Gốc rỗng: kiểu SonSon.X không ghi parent sẽ kế thừa cái này. -->
    <style name="SonSon" />

    <!-- Nút chính (.nut-son): sơn son nổi khối, viền vàng, chữ vàng nhạt, không viết hoa. -->
    <style name="SonSon.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/nut_son</item>
        <!-- MaterialButton tô màu đè lên nền tự đặt nếu còn backgroundTint. -->
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/chu_nut_son</item>
        <item name="iconTint">@color/chu_nut_son</item>
        <item name="rippleColor">#33FFE3A0</item>
        <item name="android:fontFamily">@font/baloo2_extrabold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Nút viền (.nut-vien): nền trong, viền vàng, chữ sơn son đậm. -->
    <style name="SonSon.Button.Vien" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/nut_vien_vang</item>
        <item name="backgroundTint">@null</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/chu_nut_vien</item>
        <item name="iconTint">@color/chu_nut_vien</item>
        <item name="rippleColor">#33D9A441</item>
        <item name="android:fontFamily">@font/baloo2_extrabold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Nút chữ (.nut-chu): chữ sơn son, không khung. -->
    <style name="SonSon.Button.Chu" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/chu_nut_vien</item>
        <item name="iconTint">@color/chu_nut_vien</item>
        <item name="rippleColor">#33D9A441</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <!-- Chip lọc (.chip / .chip.chon): ngà viền vàng; chọn = sơn son chữ vàng. -->
    <style name="SonSon.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/nen_chip</item>
        <item name="chipStrokeColor">@color/vien_chip</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chu_chip</item>
        <item name="checkedIconTint">@color/vang_sang</item>
        <item name="chipIconTint">@color/chu_chip</item>
        <item name="rippleColor">#33D9A441</item>
    </style>

    <!-- Chip bấm (gợi ý trong khung chat…): cùng màu, không có trạng thái chọn. -->
    <style name="SonSon.Chip.HanhDong" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/nga</item>
        <item name="chipStrokeColor">@color/vien_vang</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/muc</item>
        <item name="chipIconTint">@color/son</item>
        <item name="rippleColor">#33D9A441</item>
    </style>

    <!-- Tab (.tab-app): chữ nâu, tab đang chọn chữ sơn son đậm + gạch vàng 3dp. -->
    <style name="SonSon.Tab" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/vang</item>
        <item name="tabIndicatorHeight">3dp</item>
        <item name="tabTextColor">@color/chu_tab</item>
        <item name="tabSelectedTextColor">@color/son_dam</item>
        <item name="tabIconTint">@color/chu_tab</item>
        <item name="tabRippleColor">#29D9A441</item>
        <item name="android:background">@color/nga</item>
    </style>

    <!-- Thanh điều hướng dưới: nền ngà; huy hiệu đặt bằng mã (setItemIconTintList(null)). -->
    <style name="SonSon.ThanhDuoi" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="backgroundTint">@color/nga</item>
        <item name="itemTextColor">@color/muc_thanh_duoi</item>
        <item name="itemIconSize">28dp</item>
        <item name="itemRippleColor">#29D9A441</item>
        <item name="elevation">10dp</item>
    </style>

    <!-- Ô nhập (.truong .o): nền ngà, viền vàng nhạt, đang gõ viền sơn son, bo 12dp. -->
    <style name="SonSon.ONhap" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/vien_o_nhap</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/nga</item>
        <item name="hintTextColor">@color/son_dam</item>
        <item name="android:textColorHint">@color/chu_mo</item>
        <item name="endIconTint">@color/chu_mo</item>
        <item name="startIconTint">@color/son</item>
    </style>

    <!-- Thẻ (.the): ngà, viền vàng nhạt 1dp, bo 14dp. -->
    <style name="SonSon.The" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/nga</item>
        <item name="strokeColor">@color/vien_vang_nhat</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">14dp</item>
    </style>

    <!-- Thanh tiêu đề (.ab): tấm hoành phủ sơn son, gạch vàng đáy, chữ vàng nhạt. -->
    <style name="SonSon.ThanhTieuDe" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@drawable/bg_thanh_tieu_de</item>
        <item name="titleTextColor">@color/vang_sang</item>
        <item name="subtitleTextColor">@color/vang_nhat</item>
        <item name="titleTextAppearance">@style/SonSon.ChuTieuDe</item>
    </style>

    <style name="SonSon.ChuTieuDe" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/baloo2_extrabold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">@color/vang_sang</item>
    </style>

    <!-- Biểu tượng ba gạch / mũi tên trên thanh tiêu đề: vàng nhạt. -->
    <style name="SonSon.MuiTenMenu" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="color">@color/vang_sang</item>
        <item name="spinBars">true</item>
    </style>

    <!-- Nút nổi (.fab): sơn son, dấu vàng nhạt. -->
    <style name="SonSon.Fab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/son</item>
        <item name="tint">@color/vang_sang</item>
        <item name="rippleColor">#33FFE3A0</item>
        <item name="borderWidth">0dp</item>
    </style>

    <!-- Hộp thoại hệ thống còn sót (không đi qua HopThoai): nền ngà viền vàng, nút sơn son. -->
    <style name="SonSon.HopThoaiHeThong" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/nen_hop_thoai_he_thong</item>
        <item name="colorPrimary">@color/son</item>
        <item name="colorSecondary">@color/son</item>
        <item name="colorAccent">@color/son</item>
        <item name="android:textColorPrimary">@color/muc</item>
        <item name="android:textColorSecondary">#5A463A</item>
        <item name="buttonBarPositiveButtonStyle">@style/SonSon.Button.Chu</item>
        <item name="buttonBarNegativeButtonStyle">@style/SonSon.Button.Chu</item>
        <item name="buttonBarNeutralButtonStyle">@style/SonSon.Button.Chu</item>
    </style>

    <style name="SonSon.LichChon" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorAccent">@color/son</item>
        <item name="android:colorPrimary">@color/son</item>
        <item name="android:colorControlActivated">@color/son</item>
        <item name="android:windowBackground">@drawable/nen_hop_thoai_he_thong</item>
    </style>

    <style name="SonSon.BangDuoi" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="colorPrimary">@color/son</item>
        <item name="colorSecondary">@color/son</item>
        <item name="colorSurface">@color/nga</item>
    </style>
    <!-- ── Bổ sung cho các màn (Figma trang 02) ── -->
    <style name="SonSon.Button.Vang" parent="SonSon.Button">
        <item name="android:background">@drawable/nut_vang</item>
        <item name="android:textColor">#3A1A05</item>
        <item name="iconTint">#3A1A05</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="SonSon.Button.VienToi" parent="SonSon.Button.Vien">
        <item name="android:background">@drawable/nut_vien_toi</item>
        <item name="android:textColor">@color/vang_sang</item>
        <item name="iconTint">@color/vang_sang</item>
    </style>

    <style name="SonSon.Button.Huy" parent="SonSon.Button.Vien">
        <item name="android:background">@drawable/nut_huy</item>
        <item name="android:textColor">@color/son</item>
        <item name="iconTint">@color/son</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13.5sp</item>
    </style>

    <!-- Tiêu đề mục (.muc-app b): Baloo đậm sơn son, dấu thoi vàng phía trước. -->
    <style name="SonSon.TieuDeMuc">
        <item name="android:fontFamily">@font/baloo2_extrabold</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/son_dam</item>
        <item name="android:drawableStart">@drawable/thoi_vang</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Nhãn trạng thái (.huy-hieu): chấm tròn + chữ đậm nhỏ trong viên. -->
    <style name="SonSon.HuyHieu">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:drawableStart">@drawable/cham_hh</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="SonSon.HuyHieu.Cho">
        <item name="android:background">@drawable/nen_hh_cho</item>
        <item name="android:textColor">@color/ho_phach</item>
        <item name="android:drawableTint">@color/ho_phach</item>
    </style>
    <style name="SonSon.HuyHieu.Xong">
        <item name="android:background">@drawable/nen_hh_xong</item>
        <item name="android:textColor">@color/ngoc</item>
        <item name="android:drawableTint">@color/ngoc</item>
    </style>
    <style name="SonSon.HuyHieu.Tre">
        <item name="android:background">@drawable/nen_hh_tre</item>
        <item name="android:textColor">@color/son</item>
        <item name="android:drawableTint">@color/son</item>
    </style>
    <!-- Ô huy hiệu trang chủ (.o-menu): thẻ ngà, huy hiệu 50dp, chữ đậm nhỏ. -->
    <style name="OTrangChu" parent="SonSon.The">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="cardElevation">1dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="OTrangChuThan">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
    <style name="OTrangChuHuyHieu">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="OTrangChuChu">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/muc</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
    </style>
    <!-- Liên kết "Xem tất cả ›" cạnh tiêu đề mục (.muc-app a). -->
    <style name="LienKetMuc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/son</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">6dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>
