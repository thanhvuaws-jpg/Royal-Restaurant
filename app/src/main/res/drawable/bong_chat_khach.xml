<?xml version="1.0" encoding="utf-8"?>
<!--
    Bong bóng tin của CHÍNH KHÁCH — bộ Sơn Son (Figma .bong-chat.khach): sơn son chuyển
    đậm, viền vàng mờ, chữ vàng nhạt.
    Bo tròn ba góc, để vuông góc dưới-phải — cái đuôi ngầm chỉ về phía người
    gửi. Nhờ vậy người đọc nhận ra ai nói mà không cần đọc tên.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#A82219" android:endColor="#7A1612" />
    <stroke android:width="1dp" android:color="#99E3B34F" />
    <corners
        android:topLeftRadius="14dp"
        android:topRightRadius="14dp"
        android:bottomLeftRadius="14dp"
        android:bottomRightRadius="4dp" />
</shape>
