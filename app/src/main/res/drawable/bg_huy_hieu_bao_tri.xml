<?xml version="1.0" encoding="utf-8"?>
<!-- Huy hiệu màn bảo trì (QĐ-107): đĩa sơn son, vành vàng kép như huy hiệu menu. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#D9A441" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <gradient
                android:centerX="0.35"
                android:centerY="0.3"
                android:endColor="#5E0E0C"
                android:gradientRadius="60dp"
                android:startColor="#B3261F"
                android:type="radial" />
            <stroke
                android:width="1.5dp"
                android:color="#FFE9B5" />
        </shape>
    </item>
</layer-list>
