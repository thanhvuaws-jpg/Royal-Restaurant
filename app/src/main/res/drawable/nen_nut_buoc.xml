<?xml version="1.0" encoding="utf-8"?>
<!-- Nút − / + của bộ tăng giảm số lượng (Figma .buoc span): ngà viền vàng, bấm = vàng nhạt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="12dp" /><solid android:color="#FFF0BF" /><stroke android:width="1.5dp" android:color="#D9A441" /></shape>
    </item>
    <item>
        <shape><corners android:radius="12dp" /><solid android:color="#FFFDF8" /><stroke android:width="1.5dp" android:color="#D9A441" /></shape>
    </item>
</selector>
