<?xml version="1.0" encoding="utf-8"?>
<!-- Nút viền trên nền tối (Figma .nut-vien-toi): trong, viền vàng, chữ vàng nhạt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="14dp" /><solid android:color="#33D9A441" /><stroke android:width="1.5dp" android:color="#D9A441" /></shape>
    </item>
    <item>
        <shape><corners android:radius="14dp" /><solid android:color="#00000000" /><stroke android:width="1.5dp" android:color="#D9A441" /></shape>
    </item>
</selector>
