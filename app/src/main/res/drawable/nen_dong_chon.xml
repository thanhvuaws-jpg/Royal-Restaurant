<?xml version="1.0" encoding="utf-8"?>
<!-- Dòng lựa chọn trong hộp thoại (Figma .dong-chon): ngà viền vàng nhạt; bấm = .dong-chon.chon. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#FFF8E4" />
            <stroke android:width="2dp" android:color="#D9A441" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="#FFFDF8" />
            <stroke android:width="1dp" android:color="#73D9A441" />
        </shape>
    </item>
</selector>
