<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh tiến trình bộ Sơn Son (Figma .thanh): nền giấy dó, phần đã đi vàng chuyển vàng nhạt. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="99dp" />
            <solid android:color="#EADFCC" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="99dp" />
                <gradient android:angle="0" android:startColor="#D9A441" android:endColor="#FFE3A0" />
            </shape>
        </clip>
    </item>
</layer-list>
