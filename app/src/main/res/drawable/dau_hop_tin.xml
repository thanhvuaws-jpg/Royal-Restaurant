<?xml version="1.0" encoding="utf-8"?>
<!-- Huy hiệu trạng thái đầu hộp thoại — thông tin: sơn then (Figma .dau-hop.tin): tâm sáng lệch trên trái, viền vàng 2.5dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:centerX="0.38" android:centerY="0.3"
                android:gradientRadius="75%" android:startColor="#3A2A24" android:centerColor="#1F120D" android:endColor="#140B08" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="2.5dp" android:color="#E3B34F" />
        </shape>
    </item>
</layer-list>
