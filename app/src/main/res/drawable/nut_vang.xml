<?xml version="1.0" encoding="utf-8"?>
<!-- Nút thếp vàng (Figma .nut-vang): vàng lá nổi khối, gờ nâu, chữ nâu đậm. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item android:top="3dp"><shape><corners android:radius="14dp" /><solid android:color="#B8A99A" /></shape></item>
            <item android:bottom="3dp"><shape><corners android:radius="14dp" /><solid android:color="#E3D8C6" /></shape></item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp">
                <shape><corners android:radius="14dp" />
                    <gradient android:angle="270" android:startColor="#F7E2A6" android:centerColor="#E0B04C" android:endColor="#B57A1E" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp"><shape><corners android:radius="14dp" /><solid android:color="#5C3409" /></shape></item>
            <item android:bottom="3dp">
                <shape><corners android:radius="14dp" />
                    <gradient android:angle="270" android:startColor="#FFF0BF" android:centerColor="#F2C45C" android:endColor="#C98A26" />
                </shape>
            </item>
            <item android:bottom="3dp" android:left="10dp" android:right="10dp" android:top="2dp" android:gravity="top">
                <shape><size android:height="1.5dp" /><corners android:radius="1dp" /><solid android:color="#8CFFFFFF" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
