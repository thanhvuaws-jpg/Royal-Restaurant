<?xml version="1.0" encoding="utf-8"?>
<!-- Nút hủy (Figma .nut-huy): nền đỏ rất nhạt, viền sơn son nhạt, chữ sơn son. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape><corners android:radius="11dp" /><solid android:color="#248E1B17" /><stroke android:width="1.5dp" android:color="#8E1B17" /></shape>
    </item>
    <item>
        <shape><corners android:radius="11dp" /><solid android:color="#0F8E1B17" /><stroke android:width="1.5dp" android:color="#8C8E1B17" /></shape>
    </item>
</selector>
