<?xml version="1.0" encoding="utf-8"?>
<!-- Nền ô chọn (Spinner) theo tông app: bo góc, viền nhạt, mũi tên bên phải.
     Thay cho @android:drawable/btn_dropdown — nút xám kiểu Android đời cũ, lệch
     hẳn phần còn lại của màn đặt bàn (H25). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1dp" android:color="#D7CCC8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="12dp"
        android:width="24dp" android:height="24dp">
        <vector android:width="24dp" android:height="24dp"
            android:viewportWidth="24" android:viewportHeight="24">
            <path android:fillColor="@color/colorPrimary" android:pathData="M7,10l5,5 5,-5z" />
        </vector>
    </item>
</layer-list>
